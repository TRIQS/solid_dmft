def projectName = "solid_dmft" /* set to app/repo name */

/* which platform to build documentation on */
def documentationPlatform = "ubuntu-clang"
/* depend on triqs upstream branch/project */
def triqsBranch = env.CHANGE_TARGET ?: env.BRANCH_NAME
def triqsProject = '/CCQ/TRIQS/triqs/' + triqsBranch.replaceAll('/', '%2F')
/* Upstream TRIQS apps that solid_dmft imports at runtime. As a python-only app
   we only need them importable, so rather than rebuilding them from source we
   consume their kept installs on /mnt/triqs (see PYTHONPATH below). */
def appNames = ["cthyb", "dft_tools", "dftkit", "hubbardI", "hartree_fock", "maxent"]
def appProjects = appNames.collectEntries { [(it): '/CCQ/TRIQS/' + it + '/' + triqsBranch.replaceAll('/', '%2F')] }
def cthybProject = appProjects["cthyb"]
/* whether to keep and publish the results */
def keepInstall = !env.BRANCH_NAME.startsWith("PR-")

properties([
  disableConcurrentBuilds(),
  buildDiscarder(logRotator(numToKeepStr: '10', daysToKeepStr: '30')),
  pipelineTriggers(keepInstall ? [
    upstream(
      threshold: 'SUCCESS',
      upstreamProjects: cthybProject
    ), githubPush()
  ] : [githubPush()])
])

def installBase = "/mnt/triqs"
def mounts = ["triqs": installBase]

def runBuild = { String platform, String prefix, List<String> envs ->
  def macos = platform.startsWith("macos-")
  def buildDir = "$WORKSPACE_TMP/build"
  /* install real branches in a fixed predictable place so apps can find them */
  def installDir = keepInstall ? "$prefix/install/$JOB_NAME/$platform" : "$WORKSPACE_TMP/install"
  def triqsDir = "$prefix/install$triqsProject/${platform}"
  envs += [
    "OPENBLAS_NUM_THREADS=1",
    "MKL_NUM_THREADS=1",
    "OMP_NUM_THREADS=1",
    /* Tests run concurrently via `ctest -j`, each launching its own mpirun.
       OpenMPI binds-to-core by default and every mpirun starts binding at
       core 0, so all concurrent tests pile onto the same few cores while the
       rest idle (8x slowdowns observed). Disable binding so the scheduler
       spreads ranks, and allow oversubscription as a safety net. */
    "OMPI_MCA_hwloc_base_binding_policy=none",
    "OMPI_MCA_rmaps_base_oversubscribe=yes"]
  /* the triqs venv on macOS is built from the brew python, which may differ from the system python3 */
  def python3 = macos ? "${env.BREW}/bin/python3" : "python3"
  def pythonVer = sh(returnStdout: true, script: """$python3 -c 'import sys; print(f"{sys.version_info.major}.{sys.version_info.minor}")'""").trim()
  def triqsPy = "$triqsDir/lib/python$pythonVer"
  /* triqs plus the kept installs of the upstream apps, each in its own prefix.
     Their python extensions resolve their C++ libs (and triqs) via RPATH, which
     works because these installs live at fixed, predictable paths. */
  def pyRoots = [triqsPy] + appProjects.values().collect { "$prefix/install$it/$platform/lib/python$pythonVer" }
  envs << "PYTHONPATH=" + pyRoots.collectMany { ["$it/dist-packages", "$it/site-packages"] }.join(':')
  if (macos) {
    dir(installDir) {
      deleteDir()
    }
    checkout scm
    dir(buildDir) {
      deleteDir()
    }
    def brew = env.BREW
    def hdf5 = "$brew/opt/hdf5"
    def venv = triqsDir
    envs += [
      "PATH=$venv/bin:$brew/bin:/usr/bin:/bin:/usr/sbin",
      "HDF5_ROOT=$hdf5",
      "C_INCLUDE_PATH=$hdf5/include:$brew/include",
      "CPLUS_INCLUDE_PATH=$venv/include:$hdf5/include:$brew/include",
      "LIBRARY_PATH=$venv/lib:$hdf5/lib:$brew/lib",
      "DYLD_LIBRARY_PATH=$venv/lib:$hdf5/lib:$brew/lib",
      "CMAKE_PREFIX_PATH=$venv/lib/cmake/triqs",
      "VIRTUAL_ENV=$venv"]
    /* note: this is installing into the parent (triqs) venv (install dir), which is thus shared among apps and so not be completely safe */
    sh """#!/bin/sh -ex
      source $venv/bin/activate
      pip3 install -U -r $WORKSPACE/requirements.txt
    """
  } else {
    def path = sh(returnStdout: true, script: 'echo $PATH').trim()
    envs << "PATH=$triqsDir/bin:$path"
  }
  withEnv(envs) {
    def args = ''
    if (platform == documentationPlatform)
      args += ' -DBuild_Documentation=ON'
    else if (platform == "sanitize")
      args += ' -DASAN=ON -DUBSAN=ON -DCMAKE_BUILD_TYPE=RelWithDebInfo'
    dir(buildDir) {
      sh """#!/bin/sh -ex
        cmake $WORKSPACE -DCMAKE_INSTALL_PREFIX=$installDir -DTRIQS_ROOT=$triqsDir -DTEST_NUM_PROC=4 $args
        make -j\$PARALLEL || make -j1 VERBOSE=1
      """
      catchError(buildResult: 'UNSTABLE', stageResult: 'UNSTABLE') {
        try {
          /* Tests run 4 MPI ranks each (PROCESSORS property) with binding
             disabled (see envs), so ctest -j is a core budget. The Linux build
             pod requests cpus:16 (HT cores) = 8 physical cores, so -j8 runs 2
             concurrent 4-rank tests = 8 ranks, one per physical core, with no
             HT oversubscription. macOS m1 nodes have ~10 cores, so -j8 = 2
             concurrent 4-rank tests too. */
          def ctestJobs = 8
          sh "ctest --output-on-failure -j${ctestJobs}"
        } catch (exc) {
          archiveArtifacts(artifacts: 'Testing/Temporary/LastTest.log')
          throw exc
        }
      }
      sh "make install"
    }
  }
}

/* map of all builds to run, populated below */
def platforms = [:]

/****************** linux builds (in docker) */
/* Each platform must have a corresponding Dockerfile.PLATFORM in triqs/packaging */
def dockerPlatforms = ["ubuntu-clang", "ubuntu-gcc"]
buildImages(dockerPlatforms.collect { platform ->
  [ tag: platform,
    context: 'jenkins',
    dockerfile: "Dockerfile.$platform",
    prep: {
      /* construct a Dockerfile for this base */
      sh """
        ( echo "FROM $REGISTRY_PREFIX${triqsProject.toLowerCase()}:$platform" ; sed '0,/^FROM /d' jenkins/Dockerfile ) > jenkins/Dockerfile.$platform
      """
    }
  ]
}, checkout: true)
for (int i = 0; i < dockerPlatforms.size(); i++) {
  def platform = dockerPlatforms[i]
  platforms[platform] = { ->
    stage(platform) {
      timeout(time: 2, unit: 'HOURS') {
        /* cpus: 16 HT cores = 8 physical; tests run at ctest -j8 (see runBuild). */
        runPod(tag: platform,
          devShm: true,
          cpus: 16,
          mounts: mounts) {
          runBuild(platform, installBase, [])
        }
      }
    }
  }
}

/****************** macos builds (on host) */
def macosPlatforms = [
  ["gcc", ['CC=gcc-15', 'CXX=g++-15', 'FC=gfortran-15']],
  ["clang", ['CC=$BREW/opt/llvm/bin/clang', 'CXX=$BREW/opt/llvm/bin/clang++', 'FC=gfortran-15', 'CXXFLAGS=-I$BREW/opt/llvm/include', 'LDFLAGS=-L$BREW/opt/llvm/lib']]
]
for (int i = 0; i < macosPlatforms.size(); i++) {
  def platformEnv = macosPlatforms[i]
  def platform = platformEnv[0]
  platforms["macos-$platform"] = { -> node('macos && m1') {
    stage("macos-$platform") { timeout(time: 2, unit: 'HOURS') {
      runBuild("macos-$platform", env.HOME, platformEnv[1].collect { it.replace('\$BREW', env.BREW) })
    } }
  } }
}

/****************** wrap-up */
catchError {
  parallel platforms

  if (keepInstall) {
    /* Publish results */
    stage("publish") {
      timeout(time: 10, unit: 'MINUTES') {
        runPod(tag: documentationPlatform,
          mounts: mounts) {
          def commit = sh(returnStdout: true, script: "git rev-parse HEAD").trim()
          def release = env.BRANCH_NAME == "master" || env.BRANCH_NAME == "unstable" || sh(returnStdout: true, script: "git describe --exact-match HEAD || true").trim()
          lock(resource: 'triqs_publish') {
            /* Documentation is published per-branch to the repo's own gh-pages
               branch (https://triqs.github.io/solid_dmft/<branch>/) by the GitHub
               Actions workflows (.github/workflows/build_{unstable_doc,release}.yml
               + update_doc_index.yml). It is intentionally NOT pushed to the
               central TRIQS.github.io repo from here: a project gh-pages page
               shadows a same-named folder in the org page, so such a push would be
               unreachable. */
            /* Update packaging repo submodule */
            if (release) {
              dir("$WORKSPACE_TMP/packaging") {
                try {
                  def pkg = scmGit(branches: [[name: "refs/heads/${env.BRANCH_NAME}"]],
                    userRemoteConfigs: [[credentialsId: 'github-jenkins', url: 'https://github.com/TRIQS/packaging.git']])
                  checkout scm: pkg, changelog: false, poll: false
                  sh """#!/bin/bash -ex
                    dir="$projectName"
                    [[ -d triqs_\$dir ]] && dir=triqs_\$dir || [[ -d \$dir ]]
                    echo "160000 commit ${commit}\t\$dir" | git update-index --index-info
                    GIT_COMMITTER_EMAIL="jenkins@flatironinstitute.org" GIT_COMMITTER_NAME="Flatiron Jenkins" git commit --author='Flatiron Jenkins <jenkins@flatironinstitute.org>' -m 'Autoupdate $projectName' -m '${env.BUILD_TAG}'
                  """
                  gitPush(gitScm: pkg, targetBranch: env.BRANCH_NAME, targetRepo: 'origin')
                } catch (err) {
                  /* Ignore, non-critical -- might not exist on this branch */
                  echo "Failed to update packaging repo"
                }
              }
            }
          }
        }
      }
    }
  }
}
emailFailure()
